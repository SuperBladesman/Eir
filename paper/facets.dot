// Figure 1 of the JOSS paper: the order in which Eir assesses a structure.
// Build: dot -Tpng -Gdpi=300 facets.dot -o facets.png   (and -Tpdf for a vector copy)
digraph facets {
  graph [rankdir=TB, splines=ortho, nodesep=0.55, ranksep=0.32, fontname="Inter", bgcolor="white", pad=0.15];
  node  [fontname="Inter", fontsize=11, shape=box, style="rounded,filled", fillcolor="white", color="#17212b", penwidth=1.1, margin="0.18,0.08"];
  edge  [fontname="Inter", fontsize=9.5, color="#17212b", arrowsize=0.7, penwidth=1.0];

  cif   [group=main, label="CIF", shape=box, style="filled", fillcolor="#eef1f4", color="#586776"];
  read  [group=main, label=<<b>Reading stage</b><br/><font point-size="9.5">repairs made by feature and recorded;<br/>every bond computed from the positions</font>>];
  P [group=main, label=<<b>P</b>  Parse<br/><font point-size="9.5">Can the file be read?</font>>];
  G [group=main, label=<<b>G</b>  Geometry<br/><font point-size="9.5">Can the atoms be where the file puts them?<br/>six independent screens; a proposed origin<br/>shift is tested on a copy, never applied</font>>];
  R [group=main, label=<<b>R</b>  Reference<br/><font point-size="9.5">Are there bond valence parameters and<br/>measured bond lengths for every ion?</font>>];
  M [group=main, label=<<b>M</b>  Model<br/><font point-size="9.5">Is the deposited description unambiguous?</font>>];

  xP [group=out, width=2.75, label=<<b>EXPUNGE</b><br/><font point-size="9">no bond valence result quoted</font>>, fillcolor="#f8dcda", color="#b0271f"];
  xG [group=out, width=2.75, label=<<b>EXPUNGE</b><br/><font point-size="9">no bond valence result quoted</font>>, fillcolor="#f8dcda", color="#b0271f"];
  nR [group=out, width=2.75, label=<<b>NOT_ASSESSED</b><br/><font point-size="9">part of the analysis missing, not wrong</font>>, fillcolor="#e8ebee", color="#586776"];
  fM [group=out, width=2.75, label=<<b>FLAG</b><br/><font point-size="9">sums and GII hold, ambiguity named</font>>, fillcolor="#fbe9cc", color="#9a5800"];
  ok [group=main, label=<<b>ACCEPT</b><br/><font point-size="9">or ACCEPT_IMPRECISE, _HOMOVALENT,<br/>_HETEROVALENT; sums and GII reported</font>>, fillcolor="#d8ecdc", color="#2c6b3f"];

  cif -> read -> P;
  P -> G  [xlabel="yes "];
  G -> R  [xlabel="yes "];
  R -> M  [xlabel="yes "];
  M -> ok [xlabel="yes "];
  P -> xP [label=" no"];
  G -> xG [label=" no"];
  R -> nR [label=" no"];
  M -> fM [label=" no"];

  xP -> xG -> nR -> fM [style=invis];
  {rank=same; P; xP}
  {rank=same; G; xG}
  {rank=same; R; nR}
  {rank=same; M; fM}
}
